{
  "manifest_version": 3,
  "name": "Repo Analyzer",
  "version": "5.0.0",
  "description": "Analyze GitHub repos from the current page — local-first, no API key required.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://github.com/*"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Repo Analyzer",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle"
  }]
}
